HOST=127.0.0.1
PORT=5000
DEBUG=false
# Local embedded SQLite database; no server or database credentials required.
DB_PATH=prompt_platoon.sqlite3
# Budget guardrails. The local model's estimated external API cost is $0.
MAX_IMAGE_BYTES=5242880
MAX_INFERENCE_MS=10000
MAX_CASE_COST_USD=0.00
ESTIMATED_CASE_COST_USD=0.00
# Set a long, random API token; store only SHA-256 digest in API_Key.
DEMO_API_TOKEN=
